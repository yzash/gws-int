  v.querySelectorAll("tr[data-u]").forEach(tr => tr.onclick = () => openUser(+tr.dataset.u));
  $("#pp").onclick = () => { S.page--; render(); }; $("#pn").onclick = () => { S.page++; render(); };
  $("#dlp").onclick = () => download("gemini_people.csv", [["email", "name", "ou", "actions", "active_days", "use_cases", "apps", "top_app", "top_use_case", "first_used", "last_used", "days_since_last", "tier", "suspended"],
    ...rows.map(r => [r.email, r.name, r.ou, r.actions, r.days, r.breadth, r.apps, r.topApp, r.topUc, r.first != null ? iso(r.first) : "", r.last != null ? iso(r.last) : "", r.since ?? "", r.tier, r.susp])]);
}

function engagement(c) {
  const {a, mask, uok} = c;
  const hm = Array.from({length: 7}, () => new Array(24).fill(0));
  let after = 0; const wh = M.work_hours || {start: 8, end: 18, days: [0, 1, 2, 3, 4]};
  for (let i = 0; i < NE; i++) { if (!mask[i]) continue; const d = E.d[i]; if (d < S.from || d > S.to) continue;
    const w = wday(d), h = E.h[i]; hm[w][h]++; if (!wh.days.includes(w) || h < wh.start || h >= wh.end) after++; }
  const peak = Math.max(1, ...hm.flat());
  const bins = [["1 day", 1, 1], ["2–3 days", 2, 3], ["4–7 days", 4, 7], ["8–14 days", 8, 14], ["15+ days", 15, 1e9]];
  const freq = bins.map(([l, lo, hi]) => ({label: l, v: [...a.per.values()].filter(p => p.days.size >= lo && p.days.size <= hi).length}));
  // Weekly cohorts by first use (within the data, respecting filters)
  const fu = firstUse(mask);
  const wkOf = d => Math.floor((d - DATA_MIN) / 7);
  const act = new Map(); for (let i = 0; i < NE; i++) if (mask[i]) { const u = E.u[i]; let s = act.get(u); if (!s) act.set(u, s = new Set()); s.add(wkOf(E.d[i])); }
  const cohorts = new Map(); for (const [u, d] of fu) { if (!uok[u]) continue; const w = wkOf(d); let o = cohorts.get(w); if (!o) cohorts.set(w, o = []); o.push(u); }
  const lastW = wkOf(DATA_MAX), cw = [...cohorts.keys()].sort((x, y) => x - y);
  const maxOff = Math.min(8, lastW - (cw[0] ?? lastW));
  // Lapsed: active in the period's first part but not in its last 7 days
  const lapsed = []; for (const [u, p] of a.per) if (p.last <= S.to - 7) lapsed.push({u, last: p.last, n: p.n});
  lapsed.sort((x, y) => y.n - x.n);
  const zeroByOu = new Map(); for (let u = 0; u < NU; u++) if (uok[u] && !a.per.has(u) && !U.s[u]) { const k = DI.ou[U.ou[u]]; (zeroByOu.get(k) || zeroByOu.set(k, []).get(k)).push(u); }
  const v = $("#view");
  v.innerHTML = `<div class="tiles">
    ${tile("Outside working hours", pct(after, a.n).toFixed(0) + "%", `${wh.start}:00–${wh.end}:00 on workdays (${esc(M.tz)})`)}
    ${tile("Lapsed users", fmt(lapsed.length), "used Gemini in the period but not in its last 7 days")}
    ${tile("Never used", fmt([...zeroByOu.values()].reduce((x, y) => x + y.length, 0)), "active accounts with zero actions in the period")}
    ${tile("Avg daily active users", fmt(kpis(a, mask).avgDau), "")}
  </div>
  <div class="grid">
    <div class="card"><h2>When people use Gemini</h2><p class="sub">Actions by weekday and hour (${esc(M.tz)})</p><div class="scroll"><table class="hm">
      <tr><th></th>${Array.from({length: 24}, (_, h) => `<th>${h % 3 ? "" : h}</th>`).join("")}</tr>
      ${hm.map((r, w) => `<tr><th class="r">${WD[w]}</th>${r.map((n, h) => `<td class="c" data-tip="${WD[w]} ${h}:00 — ${fmt(n)} actions">${n ? `<span style="opacity:${(0.1 + 0.9 * n / peak).toFixed(2)}"></span>` : ""}</td>`).join("")}</tr>`).join("")}
    </table></div></div>
    <div class="card"><h2>How often people use it</h2><p class="sub">Active users by number of active days in the period</p><div id="e1"></div></div>
  </div>
  <div class="card"><h2>Weekly cohort retention</h2><p class="sub">People grouped by the week of their first Gemini use in this data; % still active N weeks later</p>
    <div class="scroll"><table><tr><th>First-use week</th><th class="n">People</th>${Array.from({length: maxOff + 1}, (_, k) => `<th class="n">Week ${k}</th>`).join("")}</tr>
    ${cw.map(w => { const us = cohorts.get(w); return `<tr><td>${iso(DATA_MIN + w * 7)}</td><td class="n">${us.length}</td>${Array.from({length: maxOff + 1}, (_, k) => {
      if (w + k > lastW) return `<td></td>`; const n = us.filter(u => act.get(u).has(w + k)).length, p = pct(n, us.length);
      return `<td class="n" data-tip="${n} of ${us.length}" style="background:color-mix(in srgb, var(--s1) ${(p * 0.55).toFixed(0)}%, transparent)">${p.toFixed(0)}%</td>`; }).join("")}</tr>`; }).join("") || `<tr><td class="empty">No data</td></tr>`}
    </table></div><p class="note">Week 0 is always 100%. Early cohorts include people who were already using Gemini before the data starts.</p></div>
  <div class="grid">
    <div class="card"><h2>Lapsed users</h2><p class="sub">Active earlier in the period, silent for the last 7+ days · click for profile</p><div class="scroll"><table>
      <tr><th>User</th><th>OU</th><th class="n">Actions</th><th>Last used</th></tr>
      ${lapsed.slice(0, 30).map(l => `<tr class="click" data-u="${l.u}"><td>${esc(U.e[l.u])}</td><td class="dim">${esc(DI.ou[U.ou[l.u]])}</td><td class="n">${fmt(l.n)}</td><td>${iso(l.last)}</td></tr>`).join("") || `<tr><td class="empty" colspan="4">None</td></tr>`}
    </table></div></div>
    <div class="card"><h2>Never used, by OU</h2><p class="sub">Targets for enablement</p>
      ${[...zeroByOu.entries()].sort((x, y) => y[1].length - x[1].length).map(([k, us]) => `<p><b>${esc(k)}</b> <span class="dim">· ${us.length}</span><br><span class="dim">${us.slice(0, 40).map(u => esc(U.e[u])).join(", ")}${us.length > 40 ? " …" : ""}</span></p>`).join("") || `<p class="empty">Everyone in scope used Gemini.</p>`}
    </div>
  </div>`;
  hbars($("#e1"), freq, {});
  bindTips(v);
  v.querySelectorAll("tr[data-u]").forEach(tr => tr.onclick = () => openUser(+tr.dataset.u));
}

// ------------------------------------------------------------------ user drawer
function openUser(u) { S.user = u; save(); drawUser(); }
function drawUser() {
  const dr = $("#drawer"), u = S.user;
  if (u == null || u >= NU) { dr.classList.remove("open"); return; }
  const idx = []; for (let i = 0; i < NE; i++) if (E.u[i] === u) idx.push(i);
  idx.sort((x, y) => E.d[y] - E.d[x] || E.h[y] - E.h[x]);
  const inP = idx.filter(i => E.d[i] >= S.from && E.d[i] <= S.to);
  const byDay = new Map(); idx.forEach(i => byDay.set(E.d[i], (byDay.get(E.d[i]) || 0) + 1));
  const cnt = (arr, key, dict) => { const m = new Map(); arr.forEach(i => m.set(E[key][i], (m.get(E[key][i]) || 0) + 1));
    return [...m.entries()].sort((x, y) => y[1] - x[1]).map(([k, v]) => ({label: dict[k], v})); };
  const hours = new Array(24).fill(0); inP.forEach(i => hours[E.h[i]]++);
  const days = [...new Set(inP.map(i => E.d[i]))].sort((x, y) => x - y);
  let streak = 0, cur = 0; days.forEach((d, k) => { cur = k && d === days[k - 1] + 1 ? cur + 1 : 1; streak = Math.max(streak, cur); });
  const first = idx.length ? E.d[idx[idx.length - 1]] : null, last = idx.length ? E.d[idx[0]] : null;
  const tier = tierOf(inP.length, S.to - S.from + 1);
  const peak = Math.max(1, ...byDay.values());
  const start = DATA_MIN - wday(DATA_MIN);
  let cal = ""; for (let d = start; d <= DATA_MAX; d++) { const n = byDay.get(d) || 0;
    cal += d < DATA_MIN ? `<i class="out"></i>` : `<i data-tip="${iso(d)}: ${n} actions">${n ? `<span style="opacity:${(0.2 + 0.8 * n / peak).toFixed(2)}"></span>` : ""}</i>`; }
  dr.innerHTML = `<div class="top"><div><h2>${esc(U.e[u])}</h2><div class="dim">${esc(U.n[u] || "")} · ${esc(DI.ou[U.ou[u]])} ${U.s[u] ? "· suspended" : ""}</div></div>
    <button type="button" id="close">Close ✕</button></div>
    <div class="tiles">${tile("Actions (period)", fmt(inP.length), `<span class="pill ${tier}">${tier}</span>`)}${tile("Active days", days.length, `longest streak ${streak} days`)}
      ${tile("Use cases", new Set(inP.map(i => E.c[i])).size, `${new Set(inP.map(i => E.a[i])).size} apps`)}
      ${tile("Last used", last != null ? iso(last) : "never", last != null ? `${DATA_MAX - last} days ago · first ${iso(first)}` : "")}</div>
    <div class="card"><h2>Daily activity</h2><p class="sub">Every day in the data · darker = more actions</p><div class="cal">${cal}</div></div>
    <div class="grid"><div class="card"><h2>Apps</h2><div id="ua"></div></div><div class="card"><h2>Use cases</h2><div id="uc"></div></div></div>
    <div class="card"><h2>Time of day</h2><p class="sub">Actions by hour (${esc(M.tz)}), selected period</p><div id="uh"></div></div>
    <div class="card"><div class="row"><h2 class="grow">Recent actions</h2><button type="button" id="dlu">Download CSV</button></div><div class="scroll"><table>
      <tr><th>Date</th><th class="n">Hour</th><th>App</th><th>Use case</th><th>Feature</th><th>Action</th></tr>
      ${idx.slice(0, 40).map(i => `<tr><td>${iso(E.d[i])}</td><td class="n">${E.h[i]}:00</td><td>${esc(DI.apps[E.a[i]])}</td><td class="dim">${esc(DI.uc[E.c[i]])}</td><td>${esc(DI.feat[E.f[i]])}</td><td>${esc(DI.act[E.x[i]])}</td></tr>`).join("") || `<tr><td colspan="6" class="empty">No Gemini actions recorded.</td></tr>`}
    </table></div><p class="note">Latest 40 of ${idx.length} actions across all data. No prompt or response content exists in Google's logs.</p></div>`;
  dr.classList.add("open");
  hbars($("#ua"), cnt(inP, "a", DI.apps)); hbars($("#uc"), cnt(inP, "c", DI.uc));
  hbars($("#uh"), hours.map((v, h) => ({label: `${h}:00`, v})).filter(x => x.v));
  bindTips(dr);
  $("#close").onclick = () => { S.user = null; save(); dr.classList.remove("open"); };
  $("#dlu").onclick = () => download(`gemini_${U.e[u].replace(/[^a-z0-9]+/gi, "_")}.csv`, [["date", "hour", "app", "use_case", "feature", "action"],
    ...idx.map(i => [iso(E.d[i]), E.h[i], DI.apps[E.a[i]], DI.uc[E.c[i]], DI.feat[E.f[i]], DI.act[E.x[i]]])]);
}

// ------------------------------------------------------------------ controls
function buildMenus() {
  document.querySelectorAll(".dd").forEach(dd => {
    const key = dd.dataset.key, items = FILTERS[key], menu = dd.querySelector(".menu");
    menu.innerHTML = `<div class="acts"><button type="button" data-a="all">All</button><button type="button" data-a="none">Clear</button></div>` +
      items.map((name, i) => `<label><input type="checkbox" value="${i}"> ${esc(name)}</label>`).join("");
    dd.querySelector("button").onclick = e => { e.stopPropagation(); document.querySelectorAll(".dd.open").forEach(o => o !== dd && o.classList.remove("open")); dd.classList.toggle("open"); };
    menu.onclick = e => e.stopPropagation();
    menu.querySelectorAll("input").forEach(cb => cb.onchange = () => { S[key] = [...menu.querySelectorAll("input:checked")].map(x => +x.value); S.page = 0; render(); });
    menu.querySelectorAll(".acts button").forEach(b => b.onclick = () => { S[key] = []; S.page = 0; render(); });
  });
  document.addEventListener("click", () => document.querySelectorAll(".dd.open").forEach(o => o.classList.remove("open")));
  $("#preset").onchange = e => { S.preset = e.target.value; applyPreset(); render(); };
  $("#from").onchange = e => { S.from = Math.max(DATA_MIN, fromIso(e.target.value)); S.preset = "custom"; if (S.from > S.to) S.to = S.from; render(); };
  $("#to").onchange = e => { S.to = Math.min(DATA_MAX, fromIso(e.target.value)); S.preset = "custom"; if (S.to < S.from) S.from = S.to; render(); };
  $("#roll").onchange = e => { S.roll = +e.target.value; render(); };
  $("#cmp").onchange = e => { S.cmp = e.target.checked; render(); };
  $("#reset").onclick = () => { S = defaults(); render(); };
  $("#tabs").querySelectorAll("button").forEach(b => b.onclick = () => { S.tab = b.dataset.tab; render(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape" && S.user != null) { S.user = null; save(); $("#drawer").classList.remove("open"); } });
  let rt; addEventListener("resize", () => { clearTimeout(rt); rt = setTimeout(render, 150); });
}
function applyPreset() {
  if (S.preset === "custom") return;
  S.to = DATA_MAX; S.from = S.preset === "all" ? DATA_MIN : Math.max(DATA_MIN, DATA_MAX - (+S.preset) + 1);
}
function syncControls() {
  $("#preset").value = S.preset; $("#roll").value = String(S.roll); $("#cmp").checked = S.cmp;
  for (const id of ["from", "to"]) { const el = $("#" + id); el.min = iso(DATA_MIN); el.max = iso(DATA_MAX); el.value = iso(S[id]); }
  document.querySelectorAll(".dd").forEach(dd => { const key = dd.dataset.key, set = new Set(S[key]);
    dd.querySelectorAll(".menu input").forEach(cb => cb.checked = set.has(+cb.value));
    const b = dd.querySelector("button"); b.textContent = { ou: "Org unit", app: "App", uc: "Use case", fam: "Type" }[key] + (set.size ? ` (${set.size})` : ""); });
  $("#tabs").querySelectorAll("button").forEach(b => b.classList.toggle("on", b.dataset.tab === S.tab));
  const chips = [];
  for (const key of ["ou", "app", "uc", "fam"]) S[key].forEach(i => chips.push(`<span class="chip">${{ou: "OU", app: "App", uc: "Use case", fam: "Type"}[key]}: <b>${esc(FILTERS[key][i])}</b><button type="button" data-k="${key}" data-i="${i}" aria-label="Remove">✕</button></span>`));
  if (S.tier && S.tab === "people") chips.push(`<span class="chip">Tier: <b>${S.tier}</b><button type="button" data-k="tier" aria-label="Remove">✕</button></span>`);
  $("#chips").innerHTML = chips.join("");
  $("#chips").querySelectorAll("button").forEach(b => b.onclick = () => { const k = b.dataset.k; if (k === "tier") S.tier = ""; else S[k] = S[k].filter(x => x !== +b.dataset.i); render(); });
}
function render() {
  if (S.preset !== "custom") applyPreset();
  S.from = Math.max(DATA_MIN, Math.min(S.from, DATA_MAX)); S.to = Math.max(S.from, Math.min(S.to, DATA_MAX));
  syncControls(); save(); hideTip();
  const c = ctx();
  $("#meta").textContent = `${iso(S.from)} → ${iso(S.to)} · ${S.to - S.from + 1} days · data ${iso(DATA_MIN)} → ${iso(DATA_MAX)}`;
  ({overview, usecases, teams, people, engagement}[S.tab] || overview)(c);
  if (S.user != null) drawUser();
}
$("#foot").innerHTML = `Source: Google Workspace Gemini audit log (Admin SDK Reports API), ${esc(M.tz)} · generated ${esc(M.generated)}${M.pseudonymised ? " · <b>pseudonymised</b>" : ""}.
  All processing happens in this page; nothing is sent anywhere. Contains per-person usage data — share only where authorised.
  Google's logs contain no prompt or response content.`;
buildMenus(); render();
})();
{% endraw %}
</script>
</body>
</html>
