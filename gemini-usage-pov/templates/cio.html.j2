<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  color-scheme: light;
  --bg: #f6f6f4; --surface: #fcfcfb; --surface-2: #f1f0ec; --border: #e3e2de;
  --text: #0b0b0b; --text-2: #52514e; --muted: #7a7974;
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --track: #efeeea; --zero: #b9b8b2;
  --good: #1a7f37; --bad: #c62828; --grid: #e9e8e4;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #111110; --surface: #1a1a19; --surface-2: #222220; --border: #2e2e2c;
    --text: #ffffff; --text-2: #c3c2b7; --muted: #8f8e87;
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --track: #252524; --zero: #5d5c57;
    --good: #57c26f; --bad: #ef6b6b; --grid: #2a2a28;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #111110; --surface: #1a1a19; --surface-2: #222220; --border: #2e2e2c;
  --text: #ffffff; --text-2: #c3c2b7; --muted: #8f8e87;
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --track: #252524; --zero: #5d5c57;
  --good: #57c26f; --bad: #ef6b6b; --grid: #2a2a28;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
       font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
main { max-width: 1280px; margin: 0 auto; padding: 20px 16px 60px; }
header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
header h1 { font-size: 22px; margin: 0; }
header .meta { color: var(--muted); font-size: 12px; }
.bar { position: sticky; top: 0; z-index: 20; background: var(--bg); padding: 10px 0; border-bottom: 1px solid var(--border);
       display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 10px; }
.bar label { font-size: 12px; color: var(--text-2); display: flex; align-items: center; gap: 6px; }
select, input[type=date], input[type=search], button {
  font: inherit; font-size: 13px; color: var(--text); background: var(--surface); border: 1px solid var(--border);
  border-radius: 8px; padding: 5px 8px; }
button { cursor: pointer; }
button:hover, select:hover { border-color: var(--muted); }
button.primary { background: var(--s1); color: #fff; border-color: var(--s1); }
.dd { position: relative; }
.dd > button::after { content: " ▾"; color: var(--muted); }
.dd .menu { display: none; position: absolute; top: 110%; left: 0; z-index: 30; min-width: 220px; max-height: 320px; overflow: auto;
            background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.12); }
.dd.open .menu { display: block; }
.dd .menu label { display: flex; gap: 8px; padding: 4px 6px; border-radius: 6px; color: var(--text); font-size: 13px; cursor: pointer; }
.dd .menu label:hover { background: var(--surface-2); }
.dd .menu .acts { display: flex; gap: 6px; padding: 4px 6px 8px; border-bottom: 1px solid var(--border); margin-bottom: 4px; }
.dd .menu .acts button { font-size: 12px; padding: 2px 8px; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0; }
.chip { font-size: 12px; border: 1px solid var(--border); background: var(--surface); border-radius: 999px; padding: 2px 10px; color: var(--text-2); }
.chip b { color: var(--text); font-weight: 600; }
.chip button { border: 0; background: none; padding: 0 0 0 6px; color: var(--muted); }
nav.tabs { display: flex; gap: 4px; margin: 16px 0 12px; border-bottom: 1px solid var(--border); overflow-x: auto; }
nav.tabs button { border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: none; padding: 8px 12px; color: var(--text-2); white-space: nowrap; }
nav.tabs button.on { color: var(--text); border-bottom-color: var(--s1); font-weight: 600; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 12px; }
.tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
.tile .l { color: var(--text-2); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
.tile .v { font-size: 26px; font-weight: 650; margin-top: 2px; font-variant-numeric: tabular-nums; }
.tile .s { color: var(--muted); font-size: 12px; }
.delta.up { color: var(--good); } .delta.down { color: var(--bad); } .delta { font-size: 12px; font-weight: 500; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 12px; margin-bottom: 12px; }
.grid.three { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; min-width: 0; margin-bottom: 12px; }
.grid .card { margin-bottom: 0; }
.card h2 { font-size: 14px; margin: 0 0 4px; }
.card .sub { color: var(--muted); font-size: 12px; margin: 0 0 10px; }
.legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--text-2); margin-bottom: 6px; }
.legend i { display: inline-block; width: 14px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 6px; }
svg.chart { width: 100%; height: 230px; display: block; overflow: visible; }
svg.chart text { fill: var(--muted); font-size: 11px; }
svg.chart .gl { stroke: var(--grid); stroke-width: 1; }
svg.chart .ln { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
svg.chart .xh { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 3; }
svg.chart .dot { stroke: var(--surface); stroke-width: 2; }
.hb { display: grid; grid-template-columns: minmax(90px, 36%) minmax(40px, 1fr) 64px; gap: 10px; align-items: center; padding: 3px 0; }
.hb .n { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hb .t { height: 14px; background: var(--track); border-radius: 0 4px 4px 0; }
.hb .f { height: 100%; background: var(--s1); border-radius: 0 4px 4px 0; min-width: 2px; }
.hb .f.z { background: var(--zero); }
.hb .v { text-align: right; font-variant-numeric: tabular-nums; }
.hb.click { cursor: pointer; } .hb.click:hover .n { color: var(--text); text-decoration: underline; }
.scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); vertical-align: middle; }
th { color: var(--text-2); font-weight: 600; font-size: 12px; white-space: nowrap; }
th.sort { cursor: pointer; user-select: none; } th.sort:hover { color: var(--text); }
th.sort.asc::after { content: " ▲"; } th.sort.desc::after { content: " ▼"; }
td.n, th.n { text-align: right; }
td.dim { color: var(--muted); }
tr.click { cursor: pointer; } tr.click:hover td { background: var(--surface-2); }
.hm td.c { padding: 0; width: 26px; height: 22px; border: 2px solid var(--surface); border-radius: 4px; background: var(--track); position: relative; }
.hm td.c span { position: absolute; inset: 0; background: var(--s1); border-radius: 3px; }
.hm th { font-weight: 400; font-size: 11px; color: var(--muted); text-align: center; border: 0; padding: 2px; }
.hm th.r { text-align: right; padding-right: 8px; white-space: nowrap; }
.mx td.c { min-width: 46px; text-align: right; font-size: 12px; position: relative; }
.mx td.c span.bg { position: absolute; inset: 2px; background: var(--s1); border-radius: 3px; }
.mx td.c b { position: relative; font-weight: 500; }
.pill { display: inline-block; font-size: 11px; border-radius: 999px; padding: 1px 8px; border: 1px solid var(--border); color: var(--text-2); }
.pill.High { border-color: var(--s1); color: var(--s1); } .pill.Zero { color: var(--muted); }
.pill.flag { border-color: var(--bad); color: var(--bad); }
.spark { width: 110px; height: 24px; display: block; }
.spark polyline { fill: none; stroke: var(--s1); stroke-width: 1.8; }
.pager { display: flex; gap: 8px; align-items: center; justify-content: flex-end; margin-top: 8px; font-size: 12px; color: var(--muted); }
.row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 10px; }
.row .grow { flex: 1; }
#tip { position: fixed; pointer-events: none; z-index: 50; background: var(--surface); color: var(--text); border: 1px solid var(--border);
       border-radius: 8px; padding: 6px 10px; font-size: 12px; box-shadow: 0 6px 18px rgba(0,0,0,.14); display: none; max-width: 280px; }
#tip .k { color: var(--text-2); }
.drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(760px, 100%); background: var(--bg); border-left: 1px solid var(--border);
          z-index: 40; overflow-y: auto; padding: 18px 18px 40px; transform: translateX(100%); transition: transform .18s ease; }
.drawer.open { transform: none; box-shadow: -12px 0 32px rgba(0,0,0,.18); }
.drawer .top { display: flex; justify-content: space-between; align-items: start; gap: 10px; margin-bottom: 12px; }
.drawer .top h2 { margin: 0; font-size: 18px; overflow-wrap: anywhere; }
.cal { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 12px); gap: 3px; overflow-x: auto; padding-bottom: 4px; }
.cal i { width: 12px; height: 12px; border-radius: 2px; background: var(--track); position: relative; }
.cal i span { position: absolute; inset: 0; border-radius: 2px; background: var(--s1); }
.cal i.out { background: transparent; }
.note { color: var(--muted); font-size: 12px; }
.empty { color: var(--muted); padding: 20px 0; text-align: center; }
footer { color: var(--muted); font-size: 12px; margin-top: 28px; }
@media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .tile .v { font-size: 22px; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>{{ title }}</h1>
    <span class="meta" id="meta"></span>
  </header>
  <div class="bar" id="bar">
    <label>Period <select id="preset">
      <option value="7">Last 7 days</option><option value="14">Last 14 days</option><option value="28" selected>Last 28 days</option>
      <option value="90">Last 90 days</option><option value="all">All data</option><option value="custom">Custom…</option></select></label>
    <input type="date" id="from" aria-label="From"><input type="date" id="to" aria-label="To">
    <label>Rolling <select id="roll"><option value="1">1 day</option><option value="7" selected>7 days</option>
      <option value="14">14 days</option><option value="28">28 days</option></select></label>
    <div class="dd" data-key="ou"><button type="button">Org unit</button><div class="menu"></div></div>
    <div class="dd" data-key="app"><button type="button">App</button><div class="menu"></div></div>
    <div class="dd" data-key="uc"><button type="button">Use case</button><div class="menu"></div></div>
    <div class="dd" data-key="fam"><button type="button">Type</button><div class="menu"></div></div>
    <label><input type="checkbox" id="cmp" checked> Compare to previous period</label>
    <button type="button" id="reset">Reset</button>
  </div>
  <div class="chips" id="chips"></div>
  <nav class="tabs" id="tabs">
    <button data-tab="overview" class="on">Overview</button><button data-tab="usecases">Use cases</button>
    <button data-tab="teams">Teams</button><button data-tab="people">People</button><button data-tab="engagement">Engagement</button>
  </nav>
  <section id="view"></section>
  <footer id="foot"></footer>
</main>
<aside class="drawer" id="drawer" aria-label="User profile"></aside>
<div id="tip"></div>
<script type="application/json" id="data">{{ data_json|safe }}</script>
<script>
{% raw %}
(() => {
"use strict";
const D = JSON.parse(document.getElementById("data").textContent);
const E = D.ev, U = D.users, DI = D.dict, M = D.meta;
const NE = E.u.length, NU = U.e.length;
const DAY = 864e5, WD = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const iso = d => new Date(d * DAY).toISOString().slice(0, 10);
const fromIso = s => Math.floor(Date.parse(s + "T00:00:00Z") / DAY);
const short = d => { const t = new Date(d * DAY); return t.toLocaleDateString(undefined, {month: "short", day: "numeric", timeZone: "UTC"}); };
const wday = d => (d + 3) % 7;  // 0 = Monday
const nf = new Intl.NumberFormat();
const fmt = v => v == null || isNaN(v) ? "–" : (Math.abs(v) >= 100 || Number.isInteger(v) ? nf.format(Math.round(v)) : v.toFixed(1));
const pct = (a, b) => b ? 100 * a / b : 0;
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const median = a => { if (!a.length) return 0; const s = [...a].sort((x, y) => x - y), m = s.length >> 1; return s.length % 2 ? s[m] : (s[m-1] + s[m]) / 2; };
const DATA_MIN = M.start_day, DATA_MAX = M.end_day;

// ------------------------------------------------------------------ state
const FILTERS = {ou: DI.ou, app: DI.apps, uc: DI.uc, fam: DI.fam};
const defaults = () => ({preset: "28", from: Math.max(DATA_MIN, DATA_MAX - 27), to: DATA_MAX, roll: 7, cmp: true,
  ou: [], app: [], uc: [], fam: [], tab: "overview", sort: "actions", dir: -1, q: "", tier: "", page: 0, group: "ou", user: null});
let S = defaults();
try { const h = decodeURIComponent(location.hash.slice(1)); if (h) S = {...S, ...JSON.parse(h)}; } catch (e) {}
const save = () => { try { history.replaceState(null, "", "#" + encodeURIComponent(JSON.stringify({...S, user: S.user}))); } catch (e) {} };

// ------------------------------------------------------------------ filtering
function userOk() {
  const ouSet = S.ou.length ? new Set(S.ou) : null;
  const ok = new Uint8Array(NU);
  for (let i = 0; i < NU; i++) ok[i] = !ouSet || ouSet.has(U.ou[i]) ? 1 : 0;
  return ok;
}
function evMask(uok) {  // dimension filters only (dates handled by callers)
  const A = S.app.length ? new Set(S.app) : null, C = S.uc.length ? new Set(S.uc) : null, F = S.fam.length ? new Set(S.fam) : null;
  const m = new Uint8Array(NE);
  for (let i = 0; i < NE; i++) {
    if (!uok[E.u[i]]) continue;
    if (A && !A.has(E.a[i])) continue;
    if (C && !C.has(E.c[i])) continue;
    if (F && !F.has(DI.uc_fam[E.c[i]])) continue;
    m[i] = 1;
  }
  return m;
}
function tierOf(actions, days) {
  if (!actions) return "Zero";
  const x = actions * 28 / Math.max(days, 1);
  return x < 5 ? "Low" : x < 20 ? "Medium" : "High";
}
// Per-period aggregate over masked events.
function agg(mask, from, to, uok) {
  const days = to - from + 1;
  const per = new Map();  // user -> {n, days:Set, first, last, apps:Map, uc:Set}
  let n = 0;
  const dau = new Array(days).fill(0).map(() => new Set()), actions = new Array(days).fill(0);
  for (let i = 0; i < NE; i++) {
    if (!mask[i]) continue;
    const d = E.d[i]; if (d < from || d > to) continue;
    n++;
    const u = E.u[i];
    let p = per.get(u); if (!p) { p = {n: 0, days: new Set(), first: d, last: d, uc: new Set(), app: new Map()}; per.set(u, p); }
    p.n++; p.days.add(d); if (d < p.first) p.first = d; if (d > p.last) p.last = d; p.uc.add(E.c[i]);
    p.app.set(E.a[i], (p.app.get(E.a[i]) || 0) + 1);
    dau[d - from].add(u); actions[d - from]++;
  }
  let pop = 0; for (let i = 0; i < NU; i++) pop += uok[i];
  return {from, to, days, n, per, pop, active: per.size, dau: dau.map(s => s.size), actions};
}
// Distinct users in trailing window ending each day.
function rolling(mask, from, to, win) {
  const lo = from - win + 1, byDay = new Map();
  for (let i = 0; i < NE; i++) {
    if (!mask[i]) continue; const d = E.d[i]; if (d < lo || d > to) continue;
    let s = byDay.get(d); if (!s) byDay.set(d, s = new Set()); s.add(E.u[i]);
  }
  const cnt = new Map(), out = [];
  const add = (d, k) => { const s = byDay.get(d); if (!s) return; for (const u of s) { const c = (cnt.get(u) || 0) + k; c ? cnt.set(u, c) : cnt.delete(u); } };
  for (let d = lo; d < from; d++) add(d, 1);
  for (let d = from; d <= to; d++) { add(d, 1); if (d - win >= lo) add(d - win, -1); out.push(cnt.size); }
  return out;
}
function firstUse(mask) {  // earliest event per user across all data (respecting dimension filters)
  const f = new Map();
  for (let i = 0; i < NE; i++) if (mask[i]) { const u = E.u[i], d = E.d[i]; if (!f.has(u) || d < f.get(u)) f.set(u, d); }
  return f;
}
function kpis(a, mask, rollArr) {
  const fu = firstUse(mask);
  let nw = 0; for (const [u] of a.per) if (fu.get(u) >= a.from) nw++;
  const days = [...a.per.values()].map(p => p.days.size);
  const r28 = rolling(mask, a.from, a.to, 28);
  let st = 0, sc = 0; a.dau.forEach((v, i) => { if (r28[i]) { st += v / r28[i]; sc++; } });
  const breadth = [...a.per.values()].map(p => p.uc.size);
  return {active: a.active, pop: a.pop, adoption: pct(a.active, a.pop), actions: a.n, apu: a.active ? a.n / a.active : 0,
    mdays: median(days), stick: sc ? 100 * st / sc : 0, nw, ret: a.active - nw, breadth: breadth.length ? breadth.reduce((x, y) => x + y, 0) / breadth.length : 0,
    avgDau: a.dau.reduce((x, y) => x + y, 0) / a.days};
}

// ------------------------------------------------------------------ charts
const tip = $("#tip");
function showTip(ev, html) { tip.innerHTML = html; tip.style.display = "block";
  const x = Math.min(ev.clientX + 14, innerWidth - tip.offsetWidth - 8), y = Math.min(ev.clientY + 14, innerHeight - tip.offsetHeight - 8);
  tip.style.left = x + "px"; tip.style.top = y + "px"; }
const hideTip = () => { tip.style.display = "none"; };

function lineChart(el, xs, series, opts = {}) {
  const W = Math.max(el.clientWidth, 280), H = 230, P = {l: 44, r: 12, t: 10, b: 26};
  const iw = W - P.l - P.r, ih = H - P.t - P.b;
  const max = Math.max(1, ...series.flatMap(s => s.values));
  const nice = (() => { const e = Math.pow(10, Math.floor(Math.log10(max))), m = max / e; return (m <= 1 ? 1 : m <= 2 ? 2 : m <= 5 ? 5 : 10) * e; })();
  const X = i => P.l + (xs.length < 2 ? iw / 2 : i * iw / (xs.length - 1)), Y = v => P.t + ih - v / nice * ih;
  let g = "";
  for (let k = 0; k <= 4; k++) { const v = nice * k / 4, y = Y(v); g += `<line class="gl" x1="${P.l}" x2="${W - P.r}" y1="${y}" y2="${y}"/><text x="${P.l - 6}" y="${y + 4}" text-anchor="end">${fmt(v)}</text>`; }
  const step = Math.max(1, Math.ceil(xs.length / Math.max(2, Math.floor(iw / 70))));
  xs.forEach((d, i) => { if (i % step === 0 || i === xs.length - 1) g += `<text x="${X(i)}" y="${H - 6}" text-anchor="middle">${opts.xfmt ? opts.xfmt(d) : short(d)}</text>`; });
  series.forEach(s => { g += `<polyline class="ln" style="stroke:${s.color};stroke-width:${s.w || 2}" points="${s.values.map((v, i) => X(i).toFixed(1) + "," + Y(v).toFixed(1)).join(" ")}"/>`; });
  el.innerHTML = `<div class="legend">${series.map(s => `<span><i style="background:${s.color}"></i>${esc(s.name)}</span>`).join("")}</div>
    <svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(opts.label || "trend")}">${g}<g class="hover"></g><rect x="${P.l}" y="${P.t}" width="${iw}" height="${ih}" fill="transparent"/></svg>`;
  const svg = el.querySelector("svg"), hov = svg.querySelector(".hover");
  svg.querySelector("rect").addEventListener("mousemove", ev => {
    const r = svg.getBoundingClientRect(), x = (ev.clientX - r.left) * W / r.width;
    const i = Math.max(0, Math.min(xs.length - 1, Math.round((x - P.l) / (iw / Math.max(1, xs.length - 1)))));
    hov.innerHTML = `<line class="xh" x1="${X(i)}" x2="${X(i)}" y1="${P.t}" y2="${P.t + ih}"/>` +
      series.map(s => `<circle class="dot" cx="${X(i)}" cy="${Y(s.values[i])}" r="4.5" fill="${s.color}"/>`).join("");
    showTip(ev, `<b>${opts.xfmt ? opts.xfmt(xs[i]) : iso(xs[i])}</b><br>` + series.map(s => `<span class="k">${esc(s.name)}:</span> ${fmt(s.values[i])}`).join("<br>"));
  });
  svg.querySelector("rect").addEventListener("mouseleave", () => { hov.innerHTML = ""; hideTip(); });
}
function hbars(el, items, opts = {}) {
  if (!items.length) { el.innerHTML = `<div class="empty">No data for this selection.</div>`; return; }
  const max = Math.max(1, ...items.map(i => i.v));
  el.innerHTML = items.map((it, k) => `<div class="hb${opts.onClick ? " click" : ""}" data-k="${k}" data-tip="${esc(it.tip || (it.label + ": " + fmt(it.v)))}">
    <span class="n">${esc(it.label)}</span><div class="t"><div class="f${it.zero ? " z" : ""}" style="width:${(100 * it.v / max).toFixed(1)}%"></div></div>
    <span class="v">${opts.pct ? it.v.toFixed(1) + "%" : fmt(it.v)}</span></div>`).join("");
  el.querySelectorAll(".hb").forEach(r => {
    r.addEventListener("mousemove", ev => showTip(ev, esc(r.dataset.tip)));
    r.addEventListener("mouseleave", hideTip);
